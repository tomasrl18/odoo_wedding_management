<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Report: Wedding Summary                                      -->
    <!-- ============================================================ -->

    <template id="report_wedding_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="wedding_management.report_wedding_summary_page"/>
            </t>
        </t>
    </template>

    <template id="report_wedding_summary_page">
        <div class="page">
            <h2>
                <span t-field="o.name"/>
            </h2>
            <div class="row mt32 mb32">
                <div class="col-6">
                    <table class="table table-sm">
                        <tr>
                            <th><span>Partner 1</span></th>
                            <td><span t-field="o.partner_1_id"/></td>
                        </tr>
                        <tr>
                            <th><span>Partner 2</span></th>
                            <td><span t-field="o.partner_2_id"/></td>
                        </tr>
                        <tr>
                            <th><span>Date &amp; Time</span></th>
                            <td><span t-field="o.date"/></td>
                        </tr>
                        <tr>
                            <th><span>Venue</span></th>
                            <td><span t-field="o.venue"/></td>
                        </tr>
                    </table>
                </div>
                <div class="col-6">
                    <table class="table table-sm">
                        <tr>
                            <th><span>Responsible</span></th>
                            <td><span t-field="o.responsible_id"/></td>
                        </tr>
                        <tr>
                            <th><span>Company</span></th>
                            <td><span t-field="o.company_id"/></td>
                        </tr>
                        <tr>
                            <th><span>Status</span></th>
                            <td><span t-field="o.state"/></td>
                        </tr>
                        <tr>
                            <th><span>Expected Guests</span></th>
                            <td><span t-field="o.expected_guests"/></td>
                        </tr>
                    </table>
                </div>
            </div>

            <h3>Budget Overview</h3>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Target Budget</th>
                        <th>Estimated</th>
                        <th>Actual Spend</th>
                        <th>Difference</th>
                        <th>Usage (%)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span t-field="o.target_budget"/></td>
                        <td><span t-field="o.estimated_budget"/></td>
                        <td><span t-field="o.actual_spend"/></td>
                        <td><span t-field="o.budget_diff"/></td>
                        <td><span t-esc="round(o.budget_usage_pct, 1)"/></td>
                    </tr>
                </tbody>
            </table>

            <h3>Guests</h3>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Confirmed Attendees</th>
                        <th>Pending Guests</th>
                        <th>Tables Occupancy (%)</th>
                        <th>Pending Tasks</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span t-field="o.confirmed_guests"/></td>
                        <td><span t-field="o.pending_guests"/></td>
                        <td><span t-esc="round(o.table_occupancy_pct, 1)"/></td>
                        <td><span t-field="o.pending_tasks"/></td>
                    </tr>
                </tbody>
            </table>

            <h3>Vendors</h3>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Vendor</th>
                        <th>Service</th>
                        <th>Agreed Amount</th>
                        <th>Advance Paid</th>
                        <th>Balance Due</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.vendor_booking_ids" t-as="v">
                        <tr>
                            <td><span t-field="v.partner_id"/></td>
                            <td><span t-field="v.service_type"/></td>
                            <td><span t-field="v.amount_agreed"/></td>
                            <td><span t-field="v.advance_paid"/></td>
                            <td><span t-field="v.balance_due"/></td>
                            <td><span t-field="v.state"/></td>
                        </tr>
                    </t>
                    <tr t-if="not o.vendor_booking_ids">
                        <td colspan="6" class="text-muted">No vendors contracted.</td>
                    </tr>
                </tbody>
            </table>

            <h3>Tasks</h3>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Responsible</th>
                        <th>Due Date</th>
                        <th>Priority</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.task_ids" t-as="t">
                        <tr>
                            <td><span t-field="t.name"/></td>
                            <td><span t-field="t.responsible_id"/></td>
                            <td><span t-field="t.due_date"/></td>
                            <td><span t-field="t.priority"/></td>
                            <td><span t-field="t.state"/></td>
                        </tr>
                    </t>
                    <tr t-if="not o.task_ids">
                        <td colspan="5" class="text-muted">No tasks registered.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <!-- ============================================================ -->
    <!-- Report: Guests and Tables                                    -->
    <!-- ============================================================ -->

    <template id="report_wedding_guests_tables">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="wedding_management.report_wedding_guests_tables_page"/>
            </t>
        </t>
    </template>

    <template id="report_wedding_guests_tables_page">
        <div class="page">
            <h2>
                <span t-field="o.name"/>
                <span> — Guests &amp; Tables</span>
            </h2>
            <p>
                <span>Date:</span>
                <span t-field="o.date"/>
                <span t-if="o.venue">
                    <span> | Venue:</span>
                    <span t-field="o.venue"/>
                </span>
            </p>

            <h3>Guests</h3>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Contact</th>
                        <th>Phone</th>
                        <th>Companions</th>
                        <th>Attendance</th>
                        <th>Menu</th>
                        <th>Table</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.guest_ids" t-as="g">
                        <tr>
                            <td><span t-field="g.name"/></td>
                            <td><span t-field="g.partner_id"/></td>
                            <td><span t-field="g.phone"/></td>
                            <td>
                                <span t-field="g.confirmed_companions"/>
                                <span>/</span>
                                <span t-field="g.allowed_companions"/>
                            </td>
                            <td><span t-field="g.attendance_state"/></td>
                            <td><span t-field="g.menu_choice"/></td>
                            <td><span t-field="g.table_id"/></td>
                        </tr>
                    </t>
                    <tr t-if="not o.guest_ids">
                        <td colspan="7" class="text-muted">No guests registered.</td>
                    </tr>
                </tbody>
            </table>

            <h3>Tables</h3>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Table</th>
                        <th>Capacity</th>
                        <th>Occupancy</th>
                        <th>Free Seats</th>
                        <th>Guests</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.table_ids" t-as="tb">
                        <tr>
                            <td><span t-field="tb.name"/></td>
                            <td><span t-field="tb.capacity"/></td>
                            <td><span t-field="tb.occupancy"/></td>
                            <td><span t-field="tb.free_seats"/></td>
                            <td>
                                <span t-esc="', '.join(tb.guest_ids.mapped('name'))"/>
                            </td>
                        </tr>
                    </t>
                    <tr t-if="not o.table_ids">
                        <td colspan="5" class="text-muted">No tables created.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <!-- ============================================================ -->
    <!-- Report: Budget by Category                                   -->
    <!-- ============================================================ -->

    <template id="report_wedding_budget">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="wedding_management.report_wedding_budget_page"/>
            </t>
        </t>
    </template>

    <template id="report_wedding_budget_page">
        <div class="page">
            <h2>
                <span t-field="o.name"/>
                <span> — Budget</span>
            </h2>
            <p>
                <span>Date:</span>
                <span t-field="o.date"/>
                <span> | Target Budget:</span>
                <span t-field="o.target_budget"/>
            </p>

            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Vendor</th>
                        <th>Estimated</th>
                        <th>Actual</th>
                        <th>Payment</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="categories"
                       t-value="list(dict.fromkeys(o.budget_line_ids.mapped('category_id')))"/>
                    <t t-foreach="categories" t-as="cat">
                        <tr class="active">
                            <td colspan="6">
                                <strong><span t-field="cat.name"/></strong>
                            </td>
                        </tr>
                        <t t-set="lines"
                           t-value="o.budget_line_ids.filtered(lambda l: l.category_id == cat)"/>
                        <t t-foreach="lines" t-as="line">
                            <tr>
                                <td><span t-field="line.category_id"/></td>
                                <td><span t-field="line.description"/></td>
                                <td><span t-field="line.vendor_id"/></td>
                                <td><span t-field="line.estimated_amount"/></td>
                                <td><span t-field="line.actual_amount"/></td>
                                <td><span t-field="line.payment_state"/></td>
                            </tr>
                        </t>
                        <tr class="table-secondary">
                            <td colspan="3" class="text-right"><em>Category total</em></td>
                            <td><em><span t-esc="sum(lines.mapped('estimated_amount'))"/></em></td>
                            <td><em><span t-esc="sum(lines.mapped('actual_amount'))"/></em></td>
                            <td></td>
                        </tr>
                    </t>
                    <tr t-if="not o.budget_line_ids">
                        <td colspan="6" class="text-muted">No budget lines registered.</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="3" class="text-right">Grand total</td>
                        <td><span t-field="o.estimated_budget"/></td>
                        <td><span t-field="o.actual_spend"/></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>

            <p class="mt32">
                <span>Difference vs. target budget:</span>
                <span t-field="o.budget_diff"/>
                <span> (</span>
                <span t-esc="round(o.budget_usage_pct, 1)"/>
                <span>% of target used)</span>
            </p>
        </div>
    </template>

    <!-- ============================================================ -->
    <!-- Print actions                                                -->
    <!-- ============================================================ -->

    <record id="action_report_wedding_summary" model="ir.actions.report">
        <field name="name">Wedding Summary</field>
        <field name="model">wedding.event</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">wedding_management.report_wedding_summary</field>
        <field name="report_file">wedding_management.report_wedding_summary</field>
    </record>

    <record id="action_report_wedding_guests_tables" model="ir.actions.report">
        <field name="name">Guests and Tables</field>
        <field name="model">wedding.event</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">wedding_management.report_wedding_guests_tables</field>
        <field name="report_file">wedding_management.report_wedding_guests_tables</field>
    </record>

    <record id="action_report_wedding_budget" model="ir.actions.report">
        <field name="name">Budget by Category</field>
        <field name="model">wedding.event</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">wedding_management.report_wedding_budget</field>
        <field name="report_file">wedding_management.report_wedding_budget</field>
    </record>

</odoo>
